{
  "name": "my-talks",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Talk decks in Markdown, built with Marp and published to GitHub Pages",
  "scripts": {
    "new": "node scripts/new.mjs",
    "add-pdf": "node scripts/add-pdf.mjs",
    "dev": "marp --server .",
    "build": "node scripts/build.mjs",
    "build:fast": "node scripts/build.mjs --no-pdf",
    "serve": "npx --yes serve _site"
  },
  "devDependencies": {
    "@marp-team/marp-cli": "^4.5.1"
  }
}
